PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/jobbridge
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRE=15m
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Local email configuration
EMAIL_USER=
EMAIL_PASS=

# Production SMTP configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

MESSAGE_ENCRYPTION_KEY=replace-with-64-hex-characters
REDIS_URL=redis://localhost:6379
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=60000
CLAMAV_REQUIRED=false

# One-time administrator bootstrap only
ADMIN_EMAIL=
ADMIN_PASSWORD=
